generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

// kind vaut "blade" | "ratchet" | "bit" : SQLite n'a pas d'enum, zod valide à la frontière.
model Part {
  id          Int    @id @default(autoincrement())
  kind        String
  name        String @unique
  weightGrams Int?

  owned      OwnedPart[]
  buildParts BuildPart[]
  wishlist   WishlistItem[]
}

model OwnedPart {
  id       Int  @id @default(autoincrement())
  ownerId  Int  @default(1)
  partId   Int
  quantity Int
  owner    User @relation(fields: [ownerId], references: [id])
  part     Part @relation(fields: [partId], references: [id])

  @@unique([ownerId, partId])
}

model Build {
  id      Int         @id @default(autoincrement())
  ownerId Int         @default(1)
  name    String
  notes   String?
  owner   User        @relation(fields: [ownerId], references: [id])
  parts   BuildPart[]
}

model BuildPart {
  id      Int   @id @default(autoincrement())
  buildId Int
  partId  Int
  build   Build @relation(fields: [buildId], references: [id])
  part    Part  @relation(fields: [partId], references: [id])
}

model WishlistItem {
  id       Int    @id @default(autoincrement())
  partId   Int
  note     String
  priority Int    @default(0)
  ownerId  Int    @default(1)
  owner    User   @relation(fields: [ownerId], references: [id])
  part     Part   @relation(fields: [partId], references: [id])
}

model User {
  id           Int       @id @default(autoincrement())
  handle       String    @unique
  displayName  String
  bio          String?
  passwordHash String
  sessions     Session[]
  ownedParts   OwnedPart[]
  builds       Build[]
  wishlist     WishlistItem[]
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}
